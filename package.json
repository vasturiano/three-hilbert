{
  "name": "three-hilbert",
  "version": "0.1.0",
  "description": "3D Hilbert curve data visualization as a ThreeJS reusable object",
  "type": "module",
  "unpkg": "dist/three-hilbert.min.js",
  "jsdelivr": "dist/three-hilbert.min.js",
  "main": "dist/three-hilbert.mjs",
  "module": "dist/three-hilbert.mjs",
  "types": "dist/three-hilbert.d.ts",
  "exports": {
    "types": "./dist/three-hilbert.d.ts",
    "umd": "./dist/three-hilbert.min.js",
    "default": "./dist/three-hilbert.mjs"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasturiano/three-hilbert.git"
  },
  "homepage": "https://github.com/vasturiano/three-hilbert",
  "keywords": [
    "3d",
    "hilbert",
    "three",
    "webgl"
  ],
  "author": {
    "name": "Vasco Asturiano",
    "url": "https://github.com/vasturiano"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vasturiano/three-hilbert/issues"
  },
  "scripts": {
    "build": "rimraf dist && rollup -c",
    "dev": "rollup -w -c rollup.config.dev.js",
    "prepare": "npm run build"
  },
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "accessor-fn": "1",
    "d3-color": "1 - 3",
    "d3-force-3d": "2 - 3",
    "d3-scale": "1 - 4",
    "d3-scale-chromatic": "1 - 3",
    "data-bind-mapper": "1",
    "kapsule": "^1.16",
    "three-hilbert-geometry": "1",
    "three-spritetext": "1",
    "tinycolor2": "1"
  },
  "peerDependencies": {
    "three": ">=0.118.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/three": ">=0.118.3",
    "@typescript/typescript6": "^6.0.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=12"
  }
}
